{"created": "2026-08-14T08:06:15.838192+00:00", "modified": "2026-08-14T08:10:54.374361+00:00", "id": 21930519, "conceptrecid": "21930518", "doi": "10.5281/zenodo.21930519", "conceptdoi": "10.5281/zenodo.21930518", "doi_url": "https://doi.org/10.5281/zenodo.21930519", "metadata": {"title": "Aurora-Lens Public Canonical Statement", "doi": "10.5281/zenodo.21930519", "publication_date": "2026-08-14", "description": "<p>Aurora-Lens is a deterministic commitment-governance architecture that determines whether candidate information, interpretations, determinations, generated outputs, releases or actions may become operative commitments. This public canonical statement defines the architecture&rsquo;s governing invariant, admissibility conditions, governed outcomes, deployment surfaces, evidence classes, public/protected boundary and development chronology. It distinguishes Aurora-Lens from RAG, conventional guardrails, model-based verification, retrieval governance and execution authorization, and establishes non-commitment as an intended governed outcome where admissibility is not established.</p>", "access_right": "open", "creators": [{"name": "Stokes, Margaret", "affiliation": null, "orcid": "0009-0004-6422-4174"}], "keywords": ["Aurora-Lens", "AI governance", "AI safety", "runtime governance", "commitment governance", "commitment admissibility", "admissibility", "consequence governance", "agentic AI", "AI agents", "deterministic governance", "epistemic governance", "epistemic admissibility", "standing", "authority", "provenance", "persistent state", "Persistent Existence Frame", "PEF", "ambiguity preservation", "non-commitment", "runtime enforcement", "AI control plane"], "related_identifiers": [{"identifier": "10.5281/zenodo.21839140", "relation": "references", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.19504665", "relation": "references", "resource_type": "publication", "scheme": "doi"}, {"identifier": "10.5281/zenodo.20356020", "relation": "references", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "https://aurora-lens.ai/", "relation": "documents", "resource_type": "other", "scheme": "url"}], "resource_type": {"title": "Report", "type": "publication", "subtype": "report"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21930518"}}]}}, "title": "Aurora-Lens Public Canonical Statement", "links": {"self": "https://zenodo.org/api/records/21930519", "self_html": "https://zenodo.org/records/21930519", "preview_html": "https://zenodo.org/records/21930519?preview=1", "doi": "https://doi.org/10.5281/zenodo.21930519", "self_doi": "https://doi.org/10.5281/zenodo.21930519", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21930519", "reserve_doi": "https://zenodo.org/api/records/21930519/draft/pids/doi", "parent": "https://zenodo.org/api/records/21930518", "parent_html": "https://zenodo.org/records/21930518", "parent_doi": "https://doi.org/10.5281/zenodo.21930518", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21930518", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21930519/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21930519/sequence/default", "files": "https://zenodo.org/api/records/21930519/files", "media_files": "https://zenodo.org/api/records/21930519/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:21930519:Aurora-Lens_Public_Canonical_Statement_v1.0_DOI.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:21930519:Aurora-Lens_Public_Canonical_Statement_v1.0_DOI.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:21930519:Aurora-Lens_Public_Canonical_Statement_v1.0_DOI.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:21930519:Aurora-Lens_Public_Canonical_Statement_v1.0_DOI.pdf/full/%5E250,/0/default.jpg", "750": "https://zen