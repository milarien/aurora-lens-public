{"created": "2026-08-04T15:11:57.059318+00:00", "modified": "2026-08-07T13:24:56.527264+00:00", "id": 21792941, "conceptrecid": "21792940", "doi": "10.5281/zenodo.21792941", "conceptdoi": "10.5281/zenodo.21792940", "doi_url": "https://doi.org/10.5281/zenodo.21792941", "metadata": {"title": "The World Before the Word", "doi": "10.5281/zenodo.21792941", "publication_date": "2026-08-04", "description": "<p class=\"PDq2pG_selectionAnchorContainer\"><em>The World Before the Word</em> argues that language and AI systems become answerable only by referring to a world that persists independently of their representations. Through the examples of a river, a one-antlered roe deer, and contemporary predictive world models, it develops a distinction between representation, standing, identity, authority, and lawful consequence.</p>\n<p>The paper argues that prediction, memory, and object-centred representation cannot by themselves establish whether an entity persists, which criteria govern its identity, whether a claim remains valid across time, or whether an action may lawfully follow. These require a persistent frame capable of preserving settled, negative, and unresolved standing.</p>\n<p>The central claim is that persistence is logically prior to prediction wherever prediction becomes consequence: <strong>the world must stand before its changes can be predicted.</strong></p>", "access_right": "open", "creators": [{"name": "Stokes, Margaret", "affiliation": null, "orcid": "0009-0004-6422-4174"}], "keywords": ["philosophy of language", "reference", "predication", "individuation", "persistence", "answerability", "ontology", "epistemic standing", "world models", "joint embedding predictive architecture", "JEPA", "artificial intelligence"], "related_identifiers": [{"identifier": "10.48550/arXiv.2506.09985", "relation": "cites", "resource_type": "publication", "scheme": "doi"}, {"identifier": "10.48550/arXiv.2602.11389", "relation": "cites", "resource_type": "publication", "scheme": "doi"}, {"identifier": "10.48550/arXiv.2603.19312", "relation": "cites", "resource_type": "publication", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21839140", "relation": "isCitedBy", "resource_type": "publication-preprint", "scheme": "doi"}], "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21792940"}}]}}, "title": "The World Before the Word", "links": {"self": "https://zenodo.org/api/records/21792941", "self_html": "https://zenodo.org/records/21792941", "preview_html": "https://zenodo.org/records/21792941?preview=1", "doi": "https://doi.org/10.5281/zenodo.21792941", "self_doi": "https://doi.org/10.5281/zenodo.21792941", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21792941", "reserve_doi": "https://zenodo.org/api/records/21792941/draft/pids/doi", "parent": "https://zenodo.org/api/records/21792940", "parent_html": "https://zenodo.org/records/21792940", "parent_doi": "https://doi.org/10.5281/zenodo.21792940", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21792940", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21792941/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21792941/sequence/default", "files": "https://zenodo.org/api/records/21792941/files", "media_files": "https://zenodo.org/api/records/21792941/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:21792941:The_World_Before_the_Word_FINAL.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:21792941:The_World_Before_the_Word_FINAL.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:21792941:The_World_Before_the_Word_FINAL.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:21792941:The_World_Before_the_Word_FINAL.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:2179