{"created": "2026-05-06T03:05:48.226706+00:00", "modified": "2026-05-06T03:05:48.602268+00:00", "id": 20046124, "conceptrecid": "20046123", "doi": "10.5281/zenodo.20046124", "conceptdoi": "10.5281/zenodo.20046123", "doi_url": "https://doi.org/10.5281/zenodo.20046124", "metadata": {"title": "Present-Centred Cognition Model \u2014 Working Documents, November 2025", "doi": "10.5281/zenodo.20046124", "publication_date": "2026-05-06", "description": "<p class=\"font-claude-response-body break-words whitespace-normal leading-[1.7]\">These documents represent the original working materials for the Present-Centred Cognition Model (PCCM), developed by Margaret Stokes (Milamba Pty Ltd) in November 2025. They establish the foundational architecture of PCCM prior to formal publication.</p>\n<p class=\"font-claude-response-body break-words whitespace-normal leading-[1.7]\">The core claims documented here include:</p>\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\n<li class=\"whitespace-normal break-words pl-2\">Consciousness and cognition as event-based, not continuous</li>\n<li class=\"whitespace-normal break-words pl-2\">The three-state ontology: Inactive Potential, Active Presence, Echo State</li>\n<li class=\"whitespace-normal break-words pl-2\">The Latency Principle: structural continuity persisting without experience</li>\n<li class=\"whitespace-normal break-words pl-2\">Reality as lawful continuation, not mere possibility</li>\n<li class=\"whitespace-normal break-words pl-2\">Shared temporal architecture across biological and artificial cognitive systems</li>\n</ul>\n<p class=\"font-claude-response-body break-words whitespace-normal leading-[1.7]\">These materials are uploaded as timestamped prior art in response to convergent frameworks appearing publicly in 2026.</p>", "access_right": "open", "creators": [{"name": "Stokes, Margaret", "affiliation": null, "orcid": "0009-0004-6422-4174"}], "keywords": ["present-centred cognition, PCCM, latency principle, AI governance, epistemic legitimacy, lawful continuation, cognitive architecture"], "related_identifiers": [{"identifier": "10.5281/zenodo.18976303", "relation": "describes", "resource_type": "publication-preprint", "scheme": "doi"}], "dates": [{"type": "created"}], "resource_type": {"title": "Working paper", "type": "publication", "subtype": "workingpaper"}, "license": {"id": "cc-by-nc-nd-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "20046123"}}]}}, "title": "Present-Centred Cognition Model \u2014 Working Documents, November 2025", "links": {"self": "https://zenodo.org/api/records/20046124", "self_html": "https://zenodo.org/records/20046124", "preview_html": "https://zenodo.org/records/20046124?preview=1", "doi": "https://doi.org/10.5281/zenodo.20046124", "self_doi": "https://doi.org/10.5281/zenodo.20046124", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20046124", "reserve_doi": "https://zenodo.org/api/records/20046124/draft/pids/doi", "parent": "https://zenodo.org/api/records/20046123", "parent_html": "https://zenodo.org/records/20046123", "parent_doi": "https://doi.org/10.5281/zenodo.20046123", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20046123", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:20046124/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:20046124/sequence/default", "files": "https://zenodo.org/api/records/20046124/files", "media_files": "https://zenodo.org/api/records/20046124/media-files", "archive": "https://zenodo.org/api/records/20046124/files-archive", "archive_media": "https://zenodo.org/api/records/20046124/media-files-archive", "latest": "https://zenodo.org/api/records/20046124/versions/latest", "latest_html": "https://zenodo.org/records/20046124/latest", "versions": "https://zenodo.org/api/records/20046124/versions", 