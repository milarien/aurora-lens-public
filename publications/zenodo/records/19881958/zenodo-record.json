{"created": "2026-04-29T11:59:17.262485+00:00", "modified": "2026-04-29T11:59:17.882239+00:00", "id": 19881958, "conceptrecid": "19881957", "doi": "10.5281/zenodo.19881958", "conceptdoi": "10.5281/zenodo.19881957", "doi_url": "https://doi.org/10.5281/zenodo.19881958", "metadata": {"title": "Aurora-Lens and Related Architecture: A Prior Art and Precedence Record", "doi": "10.5281/zenodo.19881958", "publication_date": "2026-04-29", "description": "<p class=\"MsoNormal\">This document constitutes a formal prior art and precedence record for the Aurora-Lens governance architecture and its foundational specifications. It establishes the earliest dated public artifacts, the five Australian provisional patent filings, and a structural comparison with subsequently published work in the same architectural space. The record is produced to support patent conversion, licensing, and acquisition discussions, and to provide a citable reference for the chronological and technical priority of this work.</p>\n<p class=\"MsoNormal\">The architecture described here &mdash; deterministic runtime admissibility gating, co-produced forensic audit at the moment of governance decision, refusal as a first-class outcome, and hash-chained tamper-evident audit trails &mdash; was running in production and subject to patent application in November 2025. This predates all known public publications in adjacent territory by a minimum of four months.</p>", "access_right": "open", "creators": [{"name": "Stokes, Margaret", "affiliation": null}], "keywords": ["AI governance, runtime governance, admissibility, persistent state, LLM governance, auditability, control plane"], "version": "v1.0", "language": "eng", "resource_type": {"title": "Publication", "type": "publication"}, "license": {"id": "cc-by-nc-nd-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "19881957"}}]}, "notes": "<p>Identifiers and public record</p>\n<p>ORCID<br>https://orcid.org/0009-0004-6422-4174</p>\n<p>Zenodo<br>https://doi.org/10.5281/zenodo.19879302</p>\n<p>OSF<br>https://osf.io/86bxj</p>\n<p>SSRN<br>https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=10385176</p>\n<p>GitHub<br>https://github.com/milarien</p>\n<p>&nbsp;</p>"}, "title": "Aurora-Lens and Related Architecture: A Prior Art and Precedence Record", "links": {"self": "https://zenodo.org/api/records/19881958", "self_html": "https://zenodo.org/records/19881958", "preview_html": "https://zenodo.org/records/19881958?preview=1", "doi": "https://doi.org/10.5281/zenodo.19881958", "self_doi": "https://doi.org/10.5281/zenodo.19881958", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19881958", "reserve_doi": "https://zenodo.org/api/records/19881958/draft/pids/doi", "parent": "https://zenodo.org/api/records/19881957", "parent_html": "https://zenodo.org/records/19881957", "parent_doi": "https://doi.org/10.5281/zenodo.19881957", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19881957", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:19881958/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:19881958/sequence/default", "files": "https://zenodo.org/api/records/19881958/files", "media_files": "https://zenodo.org/api/records/19881958/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:19881958:Aurora_Lens_Prior_Art_Record.pdf/full/%5E1200,/0/default.jpg"}, "archi